# OS cruft
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Editors
.vscode/
.idea/
*.swp

# Node, if a tool ever needs it here
node_modules/
npm-debug.log*

# Never commit secrets
.env
.env.*
*.pem
*.key

# dist/ is generated by `node build.js` and only needed for hosts that
# block relative asset requests. GitHub Pages serves index.html + assets/
# directly, so there is no reason to track the built copy.
dist/
